                    "        }",
                    "        var scheduleId;",
                    "pm.test('创建返回日程身份',function(){scheduleId=pm.response.json().data.id;pm.expect(scheduleId).to.be.a('number');});",
                    "if(scheduleId){pm.sendRequest('http://127.0.0.1:10086/api/v1/scheduler/schedules?view=occurrences&date='+pm.variables.get('d1_notify_date'),function(err,response){pm.test('一分钟内首提醒提交后即时加载',function(){pm.expect(err).to.eql(null);pm.expect(response.code).to.eql(200);var row=response.json().data.items.find(function(x){return x.scheduleId===scheduleId;});pm.expect(row).to.exist;pm.expect(row.source).to.eql('persisted');pm.expect(row.deliveryStatus).to.eql('loaded');});});}",
