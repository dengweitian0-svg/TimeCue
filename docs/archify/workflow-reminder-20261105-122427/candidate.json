  "cards": [
    {
      "dot": "cyan",
      "title": "投递与确认分别记录",
      "items": [
        "loaded 仅表示等待执行；sent 仅表示 Windows 接受展示，不证明用户已看到。",
        "确认写 acknowledged_at；点击、阅读、分页、刷新均不确认，也不重新展示。"
      ]
    },
    {
      "dot": "amber",
      "title": "运行内身份与恢复边界",
      "items": [
        "初始化与领取先核验 Go 运行身份；新批次、断线及 404 再核验，身份变化作废旧尝试。",
        "任务、attempt、冻结决定和展示预算只存内存；重启按持久提醒与规则重建，旧身份失效。",
        "未知结果不设租约或心跳自动重展；明确执行者退出才整理指定 attempt，可信迟到 sent 仍可回填。",
        "新遗漏合并未开始的恢复任务；已开始任务保留成员、身份和原预算。"
      ]
    },
    {
      "dot": "emerald",
      "title": "历史、待确认与可投递不是同一数量",
      "items": [
        "恢复从可证明的最早边界扫描到固定整分钟上界；未知早期规则不猜测。",
        "完整历史、当前未确认和可投递分别统计；整理未完成时遗漏总数为 null。",
        "今日与历史待确认按北京时间零点划分；任务和 attempt 成员每页 50 条。"
      ]
    },
    {
      "dot": "violet",
      "title": "正式操作与宿主退出",
      "items": [
        "日程写入、确认、claim、start、results 共用 App.operations；存储在事务内再核验资格。",
        "暂停、取消、删除会停止后续投递；已经开始的真实结果仍可回填，成功不被失败覆盖。",
        "窗口隐藏后提醒继续运行；明确退出先停新任务，已知回执在宿主共享 5 秒预算内尽力回填。"
      ]
    }
  ]
}