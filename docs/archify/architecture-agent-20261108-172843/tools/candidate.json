  "cards": [
    {
      "dot": "cyan",
      "title": "六个工具",
      "items": [
        "get_schedule、list_schedules、query_occurrences 三个查询可并行；create_schedule、update_schedule、delete_schedule 串行，均走正式 App 业务入口。",
        "创建和修改使用空业务键；修改保留未提交字段并检查 expectedRevision。相对日期按实际解析时的北京时间处理。"
      ]
    },
    {
      "dot": "amber",
      "title": "删除身份与业务事务",
      "items": [
        "仅删除标记危险。首次登记生成 tool:{tool_call_id}:{uuid} 并经 context 注入。正式删除先核对回执，再检查版本，软删除、提醒联动与回执同事务。"
      ]
    },
    {
      "dot": "violet",
      "title": "尝试与逻辑结果",
      "items": [
        "ToolFactory 默认并发 3、单次 30 秒，热读并发及超时。仅超时或明确暂时故障可重试，预算首次登记固定，首次外默认 3 次，退避 5 / 10 / 20 秒。",
        "同一把启动锁串行化尝试登记与取消受理。已撤销尝试的迟到结果无法结算；参数和业务错误通过原工具 ID 回填。"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复边界",
      "items": [
        "已配对项直接复用。未配对的 running 或 retry_wait 先只读核对删除回执，命中后直接结算，其余按原身份及剩余预算处理。",
        "取消时停止启动新尝试。持久化故障撤销有效尝试，并把已返回的事实交给 Loop 收尾。"
      ]
    }
  ]
