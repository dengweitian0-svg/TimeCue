  "cards": [
    {
      "dot": "cyan",
      "title": "六个工具",
      "items": [
        "get_schedule、list_schedules、query_occurrences 三个查询可并行；create_schedule、update_schedule、delete_schedule 串行，均走正式 App 业务入口。",
        "创建和修改使用空业务键；修改保留未提交字段并检查 expectedRevision。相对日期按实际解析时的北京时间处理。"
      ]
    },
    {
      "dot": "amber",
      "title": "删除身份与业务事务",
      "items": [
        "仅删除标记危险。首次登记生成 tool:{tool_call_id}:{uuid} 并经 context 注入。正式删除先核对回执，再检查版本，软删除、提醒联动与回执同事务。"
      ]
    },
    {
      "dot": "violet",
      "title": "尝试与逻辑结果",
      "items": [
        "默认并发 3、单次 30 秒；并发和超时热读。仅超时或明确暂时故障可重试，预算首次登记固定，默认首次外 3 次，退避 5 / 10 / 20 秒。",
        "超时释放有效尝试，旧 token 的迟到返回无法结算。重试等待不写最终结果；业务失败只作为 tool_result 回填。"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复边界",
      "items": [
        "已有原 ID 配对直接复用。仍未配对的 running 或 retry_wait 先读删除回执，命中免重试；其余沿原身份和固定剩余预算，取消时走只读收尾。"
      ]
    }
  ]
