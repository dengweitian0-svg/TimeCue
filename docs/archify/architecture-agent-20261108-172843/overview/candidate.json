  "cards": [
    {
      "dot": "cyan",
      "title": "Go 宿主与启动边界",
      "items": [
        "Go 宿主独占环回端口并准备 SQLite。App 完成提醒调度启动与恢复后，宿主初始化 Loop。",
        "自 Go 启动起 8 秒内接纳 Loop 才开放聊天路由。失败或超时仅提供日程、提醒和健康检查；HTTP 进入接收循环后发布托管 ready。"
      ]
    },
    {
      "dot": "violet",
      "title": "两段 SSE",
      "items": [
        "上游 SSE 由 completion 解析。Loop 将正文与思考分批保存，Flutter 从本机 SSE 或分页接口读取已提交事件。"
      ]
    },
    {
      "dot": "amber",
      "title": "两类事务",
      "items": [
        "日程写入由 App 执行业务事务。工具结果、配对消息和 checkpoint 由 SQLite 聊天事务保存；恢复时可只读核对删除回执。"
      ]
    },
    {
      "dot": "emerald",
      "title": "事实来源",
      "items": [
        "Loop 协调执行，chat 负责消息组装和进度投影。模型适配后的最终请求正文用于预算估算、原样持久化及实际发送。",
        "退出时 Loop 先停止推进并保存已接收进度。仍在使用 App 或 SQLite 的工具实际返回后才发出 LoopDone。"
      ]
    }
  ]
