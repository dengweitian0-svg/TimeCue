  "cards": [
    {
      "dot": "cyan",
      "title": "启动与结束",
      "items": [
        "预算超限且没有可用摘要路径时，原子创建失败回执与 start / error / end，不登记模型调用。",
        "普通完成、失败及取消由终态事务保存尾批和 end，Flutter 用 run.output 对齐最终正文。"
      ]
    },
    {
      "dot": "violet",
      "title": "两层循环",
      "items": [
        "网络重试沿用同一条 model_call。工具回填与正常 length 续写新建调用，摘要也有独立调用。",
        "模型有工具并同时 length 时，先处理整批工具，再决定续写。",
        "回到模型调用时按原结果进入续写、工具回填或运行中摘要；开始新的 model_call 后继续同一循环。"
      ]
    },
    {
      "dot": "amber",
      "title": "失败与中断",
      "items": [
        "用户取消、宿主退出和持久化故障各走独立收尾分支，详见恢复图。"
      ]
    }
  ]
